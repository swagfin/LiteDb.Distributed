@page "/"
@using System.Text.Json

<PageTitle>LiteDb Distributed Studio</PageTitle>

@if (_busy)
{
    <div class="status-strip status-working status-loading" role="status" aria-live="polite">
        <span class="loading-spinner" aria-hidden="true"></span>
        <span class="loading-text">Working on your request...</span>
        <span class="loading-line" aria-hidden="true"></span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="status-strip status-error">@_errorMessage</div>
}
else if (!string.IsNullOrWhiteSpace(_infoMessage))
{
    <div class="status-strip status-info">@_infoMessage</div>
}

<div class="studio-grid">
    @if (ShowProfileManagement)
    {
        <section class="studio-panel profile-panel profile-manager-panel">
            <div class="panel-head">
                <div class="h2">Profile Management</div>
                <p>Select an existing profile or create a new one before opening Data Explorer.</p>
            </div>

            @if (ActiveProfile is not null)
            {
                <div class="active-connection-hint">
                    <span>Connected: @ActiveProfile.Name (@ActiveProfile.Database)</span>
                    <button type="button" class="btn btn-ghost" @onclick="OpenDataExplorer">Open Data Explorer</button>
                </div>
            }

            <div class="profile-list">
                @foreach (ConnectionProfile profile in OrderedProfiles)
                {
                    <button type="button"
                            class="profile-chip @(profile.Id == _selectedProfileId ? "active" : string.Empty)"
                            @onclick="() => SelectProfile(profile.Id)"
                            disabled="@(_busy || IsProfileActionBusy)">
                        <span class="profile-chip-name">@profile.Name</span>
                        <span class="profile-chip-meta">@profile.Database - @profile.BaseUrl</span>
                    </button>
                }

                @if (_profiles.Count == 0)
                {
                    <p class="empty-label">No saved profile yet. Fill the form and save one.</p>
                }
            </div>

            <div class="editor-grid">
                <label>
                    <span>Profile Name</span>
                    <input @bind="_editor.Name" placeholder="Branch Node 01" disabled="@(_busy || IsProfileActionBusy)" />
                </label>
                <label>
                    <span>Server URL</span>
                    <input @bind="_editor.BaseUrl" placeholder="http://localhost:1446" disabled="@(_busy || IsProfileActionBusy)" />
                </label>
                <label>
                    <span>Database</span>
                    <input @bind="_editor.Database" placeholder="testapp" disabled="@(_busy || IsProfileActionBusy)" />
                </label>
                <label>
                    <span>ApiKey</span>
                    <input @bind="_editor.Credential" placeholder="sample-local-key" disabled="@(_busy || IsProfileActionBusy)" />
                </label>
            </div>

            <div class="action-row">
                <button type="button" class="btn btn-ghost" @onclick="StartNewProfile" disabled="@(_busy || IsProfileActionBusy)">New</button>
                <button type="button" class="btn btn-primary" @onclick="SaveProfileAsync" disabled="@(_busy || IsProfileActionBusy)">@(_savingProfile ? "Saving..." : "Save")</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteProfileAsync" disabled="@(_busy || IsProfileActionBusy || _selectedProfileId is null)">Delete</button>
                <button type="button" class="btn btn-success" @onclick="ConnectUsingEditorAsync" disabled="@(_busy || IsProfileActionBusy)">@(_connectingProfile ? "Connecting..." : "Connect")</button>
            </div>
        </section>
    }
    else
    {
        <section class="studio-panel workspace-panel">
            <div class="connected-profile-bar">
                <article>
                    <span>Profile</span>
                    <strong>@(ActiveProfile?.Name ?? "-")</strong>
                </article>
                <article>
                    <span>Server</span>
                    <strong>@(ActiveProfile?.BaseUrl ?? "-")</strong>
                </article>
                <article>
                    <span>Database</span>
                    <strong>@(ActiveProfile?.Database ?? "-")</strong>
                </article>
                <article>
                    <span>ApiKey</span>
                    <strong>@MaskApiKey(ActiveProfile?.Credential)</strong>
                </article>
                <div class="connected-profile-actions">
                    <button type="button" class="btn btn-ghost" @onclick="OpenProfileManagement">Manage Profiles</button>
                </div>
            </div>

            <div class="panel-head workspace-head">
                <div>
                    <div class="h2">Data Explorer</div>
                    <p>@ActiveProfileSummary</p>
                </div>
                <button type="button" class="btn btn-ghost" @onclick="RefreshCollectionsAsync" disabled="@(ActiveProfile is null)">Refresh</button>
            </div>

            <div class="kpi-grid">
                <article>
                    <span>Node</span>
                    <strong>@(_overview?.NodeId ?? "-")</strong>
                </article>
                <article>
                    <span>Online Nodes</span>
                    <strong>@(_overview?.Nodes.Count(n => n.IsOnline) ?? 0)</strong>
                </article>
                <article>
                    <span>Logical DBs</span>
                    <strong>@(_overview?.Databases.Count ?? 0)</strong>
                </article>
                <article>
                    <span>Tables</span>
                    <strong>@_collections.Count</strong>
                </article>
            </div>

            <div class="explorer-body">
                <aside class="tables-pane">
                    <div class="tables-head">
                        <div class="h3">Tables</div>
                        <span class="tables-count">@_collections.Count</span>
                    </div>

                    <div class="tables-options">
                        <label class="toggle-option">
                            <input type="checkbox" checked="@_includeSystemCollections" @onchange="OnSystemCollectionsChangedAsync" />
                            <span>Show System Tables</span>
                        </label>
                    </div>

                    <div class="table-create-row">
                        <input @bind="_newCollectionName" placeholder="new_table_name" />
                        <button type="button" class="btn btn-primary" @onclick="CreateCollectionAsync" disabled="@(_busy || _creatingCollection || ActiveProfile is null)">@(_creatingCollection ? "Creating..." : "Create")</button>
                    </div>

                    <div class="tables-list">
                        @if (_collections.Count == 0)
                        {
                            <p class="empty-label">No browsable tables yet. Create one to begin.</p>
                        }
                        else
                        {
                            @foreach (string collection in _collections)
                            {
                                <button type="button"
                                        class="table-item @(string.Equals(collection, _selectedCollection, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                        @onclick="() => SelectCollectionAsync(collection)">
                                    <span class="table-item-content">
                                        <span>@collection</span>
                                        @if (IsReservedCollection(collection))
                                        {
                                            <span class="table-badge">system</span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </div>
                </aside>

                <section class="query-results-pane">
                    @if (SelectedCollectionIsSystem)
                    {
                        <div class="status-strip status-info system-collection-note">
                            System table mode is read-only. Save/Delete are disabled for '@_selectedCollection'.
                        </div>
                    }

                    <div class="query-toolbar">
                        <label>
                            <span>Active Table</span>
                            <input value="@(_selectedCollection ?? string.Empty)" readonly />
                        </label>
                        <label>
                            <span>Skip</span>
                            <input type="number" min="0" step="1" @bind="_skip" />
                        </label>
                        <label>
                            <span>Take</span>
                            <input type="number" min="1" max="10000" step="1" @bind="_take" />
                        </label>
                        <div class="toolbar-buttons">
                            <button type="button" class="btn btn-primary" @onclick="BrowseCollectionAsync" disabled="@(ActiveProfile is null || string.IsNullOrWhiteSpace(_selectedCollection))">Run Table Query</button>
                        </div>
                    </div>

                    <div class="id-query-row">
                        <label>
                            <span>@(SelectedCollectionIsSystem ? "Lookup by Key" : "Lookup by Id")</span>
                            <div class="inline-input">
                                <input @bind="_idLookup" placeholder="@(SelectedCollectionIsSystem ? "cache-key" : "ordtx-20260407123456000001")" />
                                <button type="button" class="btn btn-ghost" @onclick="LookupByIdAsync" disabled="@(ActiveProfile is null)">Find</button>
                                <button type="button" class="btn btn-ghost" @onclick="ClearIdFilterAsync" disabled="@(ActiveProfile is null)">Clear</button>
                            </div>
                        </label>
                    </div>

                    <div class="query-editor-row">
                        <label>
                            <span>LiteQL Query (Read-Only)</span>
                            <textarea class="query-textarea" @bind="_queryText" spellcheck="false"></textarea>
                        </label>
                        <div class="query-editor-actions">
                            <label>
                                <span>Max Rows</span>
                                <input type="number" min="1" max="10000" step="1" @bind="_queryTake" />
                            </label>
                            <button type="button" class="btn btn-ghost" @onclick="UseCollectionTemplate">Use Table Template</button>
                            <button type="button" class="btn btn-primary" @onclick="RunLiteQueryAsync" disabled="@(ActiveProfile is null)">Run LiteQL</button>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    @foreach (string column in DisplayColumns)
                                    {
                                        <th>@column</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (_documents.Count == 0)
                                {
                                    <tr>
                                        <td class="empty-row" colspan="@(Math.Max(DisplayColumns.Count, 1))">No documents loaded.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (Dictionary<string, JsonElement> document in _documents)
                                    {
                                        <tr class="@GetDocumentRowClass(document)" @onclick="() => SelectDocument(document)">
                                            @foreach (string column in DisplayColumns)
                                            {
                                                <td>@FormatCell(document, column)</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="document-editor">
                        <div class="editor-head">
                            <div>
                                <div class="h3">Document Editor</div>
                                <p>Use JSON payloads and save directly to the distributed node.</p>
                            </div>
                            <div class="action-row compact">
                                <button type="button" class="btn btn-ghost" @onclick="CreateDocumentTemplate" disabled="@SelectedCollectionIsSystem">New Document</button>
                                <button type="button" class="btn btn-primary" @onclick="SaveDocumentAsync" disabled="@(ActiveProfile is null || SelectedCollectionIsSystem)">Save</button>
                                <button type="button" class="btn btn-danger" @onclick="DeleteDocumentAsync" disabled="@(string.IsNullOrWhiteSpace(_selectedDocumentId) || ActiveProfile is null || SelectedCollectionIsSystem)">Delete</button>
                            </div>
                        </div>

                        <label class="id-field">
                            <span>Document Id</span>
                            <input @bind="_selectedDocumentId" placeholder="Id used for PUT/DELETE" readonly="@SelectedCollectionIsSystem" />
                        </label>

                        <textarea @bind="_documentJson" spellcheck="false" readonly="@SelectedCollectionIsSystem"></textarea>
                    </div>
                </section>
            </div>
        </section>
    }
</div>
